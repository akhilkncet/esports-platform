# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration
# Railway sets DATABASE_URL automatically when you add PostgreSQL
# DATABASE_URL=postgresql://username:password@host:port/database_name

# CORS Configuration (not needed for API-only backend)
# CORS_ALLOWED_ORIGINS=

# IMPORTANT: CSRF Trusted Origins - Set to your actual Railway URL
# This is REQUIRED for the app to work in production
# Example: CSRF_TRUSTED_ORIGINS=https://esports-platform-production.up.railway.app
# Get your Railway URL from the project settings
CSRF_TRUSTED_ORIGINS=
